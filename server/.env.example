# Get a key at https://build.nvidia.com -> sign in -> any model -> "Get API Key"
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase. Dashboard -> Project Settings -> API.
# The service_role key bypasses every row-level security policy: it belongs
# here and nowhere else. It must never appear anywhere under mobile/.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Only needed if you want the migration applied for you.
# Dashboard -> Project Settings -> Database -> Connection string -> URI
SUPABASE_DB_URL=

PORT=8787
# 1 = never call NVIDIA, serve canned fixtures (offline demo safety net)
SMRUTI_MOCK=0
