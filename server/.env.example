NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: only needed to ingest a Drive FOLDER link (single files work without it)
GOOGLE_API_KEY=
PORT=8787
# 1 = never call NVIDIA, serve canned fixtures (offline demo safety net)
SMRUTI_MOCK=0
