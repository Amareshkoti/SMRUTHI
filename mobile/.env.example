# Supabase. Dashboard -> Project Settings -> API.
#
# EXPO_PUBLIC_* values are compiled into the app bundle in plain text. That is
# fine for these two -- the anon key is designed to be published -- but it means
# row-level security is the ONLY thing protecting anyone's records. Never put
# the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: point the app at a deployed API instead of your laptop.
# EXPO_PUBLIC_SMRUTI_API=https://smruti.example.com

# This is intentionally the Vapi *public* key, which Vapi's mobile SDK uses
# to start a web call. Do not put a Vapi private key anywhere under mobile/.
EXPO_PUBLIC_VAPI_PUBLIC_KEY=your-vapi-public-key

# Create an assistant in the Vapi dashboard and copy its assistant ID here.
EXPO_PUBLIC_VAPI_ASSISTANT_ID=your-vapi-assistant-id
