{
  "expo": {
    "name": "SMRUTI",
    "slug": "smruti",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SMRUTI uses your microphone for private voice conversations about your health reports.",
        "UIBackgroundModes": [
          "voip"
        ]
      }
    },
    "android": {
      "package": "com.smruti.app",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ],
      "intentFilters": [
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "application/pdf"
            }
          ]
        },
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "image/*"
            }
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B0E11",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "SMRUTI uses the camera to estimate your pulse from your fingertip, and to photograph reports you add."
        }
      ],
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "newArchEnabled": false,
    "scheme": "smruti",
    "backgroundColor": "#0B0E11",
    "splash": {
      "backgroundColor": "#0B0E11",
      "resizeMode": "contain"
    },
    "extra": {
      "ai": {
        "nvidiaApiKey": "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"
      },
      "eas": {
        "projectId": "a64e1c2e-517b-4f1c-b66b-c7b7fd80ce15"
      }
    },
    "owner": "amareshtemps-team"
  }
}
